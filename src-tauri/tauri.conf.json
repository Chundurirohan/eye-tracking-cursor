{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaze",
  "version": "1.0.0",
  "identifier": "com.rohanchunduri.eyeapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Gaze",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Rohan Chunduri",
    "category": "public.app-category.utilities",
    "shortDescription": "Hands-free gaze cursor control",
    "longDescription": "Gaze estimates where you are looking with your webcam and moves the macOS cursor there, clicking by dwell — hands-free system-wide control.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
