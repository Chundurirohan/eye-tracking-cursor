<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required once the app is signed with Hardened Runtime (which Tauri enables
         whenever APPLE_SIGNING_IDENTITY is set). Without this the camera is denied
         at the runtime level BEFORE TCC is consulted: no permission prompt appears,
         nothing is logged by tccd, and the app just reports "no camera" no matter
         what System Settings says. Unsigned/ad-hoc builds have no Hardened Runtime
         and so never needed it — which is why this only broke after signing. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
